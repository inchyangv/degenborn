# ── Data Source ─────────────────────────────────────
# Choose one: moralis | covalent | rpc
DATA_SOURCE=moralis

MORALIS_API_KEY=your_moralis_api_key
COVALENT_API_KEY=your_covalent_api_key
RPC_URL=https://bsc-dataseed.binance.org/

# ── AI Services ──────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
# Optional: Anthropic for narrative generation
ANTHROPIC_API_KEY=your_anthropic_api_key

# Image generation (fal.ai / replicate / openai)
IMAGE_PROVIDER=openai
FAL_AI_KEY=your_fal_ai_key
REPLICATE_API_TOKEN=your_replicate_token

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/degenborn
# For local dev without Postgres, use SQLite:
# DATABASE_URL=file:./degenborn.db

# ── Smart Contract ───────────────────────────────────
PRIVATE_KEY=your_deployer_private_key
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/
BSCSCAN_API_KEY=your_bscscan_api_key

# Contract addresses (filled after deploy)
SOUL_CORE_ADDRESS=
SNAPSHOT_RELIC_ADDRESS=

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_SOUL_CORE_ADDRESS=

# ── Memory / Unibase (P1) ─────────────────────────────
UNIBASE_API_KEY=
UNIBASE_ENABLED=false

# ── WalletConnect ────────────────────────────────────
# Get a free project ID at https://cloud.walletconnect.com
# Required for WalletConnect v2 (Trust Wallet, MetaMask Mobile, etc.)
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# ── BSC RPC ───────────────────────────────────────────
NEXT_PUBLIC_BSC_RPC=https://bsc-dataseed.binance.org/

# ── Misc ─────────────────────────────────────────────
NODE_ENV=development
